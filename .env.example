# --- LLM (Ollama, local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=qwen2.5:7b
OLLAMA_CLASSIFIER_MODEL=qwen2.5:1.5b

# --- Redis (session memory + Pub/Sub event bus) ---
REDIS_URL=redis://localhost:6379/0

# --- Postgres (long-term per-child memory, pgvector enabled) ---
DATABASE_URL=postgresql+asyncpg://tutor:tutor@localhost:5432/ai_tutor
POSTGRES_USER=tutor
POSTGRES_PASSWORD=tutor
POSTGRES_DB=ai_tutor

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# --- Frontend ---
VITE_WS_URL=ws://localhost:8000/ws
VITE_API_URL=http://localhost:8000/api
